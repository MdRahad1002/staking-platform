# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stake_platform"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-min-32-chars-change-in-production"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="StakePlatform <noreply@stakeplatform.com>"

# NOWPayments (crypto deposit gateway - https://nowpayments.io)
NOWPAYMENTS_API_KEY="your-nowpayments-api-key"
NOWPAYMENTS_IPN_SECRET="your-nowpayments-ipn-secret"

# WestWallet
WESTWALLET_API_KEY="your-westwallet-api-key"
WESTWALLET_API_URL="https://api.westwallet.io"

# Telegram (for notifications)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_ADMIN_CHAT_ID="your-admin-chat-id"

# Seed passwords (required when running `prisma db seed` - use strong, unique values)
SEED_ADMIN_PASSWORD="change-me-strong-admin-password"
SEED_WORKER_PASSWORD="change-me-strong-worker-password"
SEED_SUPPORT_PASSWORD="change-me-strong-support-password"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="StakePlatform"
# Admin email for escalation alerts (bot notifies this address when a user requests human support)
ADMIN_EMAIL="admin@yourdomain.com"

# Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="5242880"
